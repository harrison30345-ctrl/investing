# QuantEdge configuration — copy to `.env` and fill in. Placeholders only.
# `.env` is git-ignored. Never commit real keys.

# Market data: yahoo (free, delayed, unofficial, personal use) | eodhd (paid) | demo (synthetic)
QE_DATA_PROVIDER=yahoo
EODHD_API_KEY=your-eodhd-key-here

# Storage. Default is SQLite at ~/.quantedge/quantedge.db.
# Cloud example: postgresql+psycopg://quantedge:password@db:5432/quantedge
# QE_DATABASE_URL=

# Safety: only "research" or "paper" are accepted. There is no live mode.
QE_TRADING_MODE=research

# Years of daily history to load on first fetch
QE_HISTORY_YEARS=10

# AI agents. Leave QE_LLM_PROVIDER=none to disable all LLM calls (the default).
# Set QE_LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY to enable.
QE_LLM_PROVIDER=none
QE_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=your-anthropic-key-here
QE_LLM_EFFORT=high                 # low | medium | high | xhigh | max (higher = more thorough, more tokens)
QE_LLM_MAX_TOKENS=16000            # per call, includes thinking
QE_LLM_MONTHLY_BUDGET_USD=10       # hard cap: calls are refused once month-to-date spend would exceed it
QE_LLM_CYCLE_BUDGET_USD=2.5        # hard cap per research cycle (a full cycle is ~$0.70 typical, ~$2 worst case)
QE_LLM_TIMEOUT_S=240
QE_AGENT_MAX_ATTEMPTS=2            # per agent task, transient errors only
QE_AGENT_MAX_EXPERIMENTS=5         # backtests the Research Director may launch per cycle
QE_AGENT_AUTORUN=true              # false = every agent-proposed backtest waits for your approval
QE_AGENT_CYCLE_TIMEOUT_S=1200

# Cash interest on uninvested cash: fred (US T-bill / UK SONIA from FRED, free) | zero | a constant like 0.04
QE_CASH_RATE=fred

# Background worker and alerts
QE_WORKER_TICK_S=30                # how often the worker checks for due jobs
# QE_ALERT_WEBHOOK_URL=            # optional: alerts are POSTed here as JSON {"text": ...}; unset = dashboard + logs only

# Cloud deployment (docker compose) only
POSTGRES_PASSWORD=change-me-to-a-long-random-string
QE_DOMAIN=quantedge.example.com          # DNS A record pointing at the server
QE_BASIC_AUTH_USER=you
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# In .env, write each $ in the hash as $$ (docker compose escaping).
QE_BASIC_AUTH_HASH=$$2a$$14$$replace-with-generated-hash
