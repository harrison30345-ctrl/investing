# QuantEdge configuration — copy to `.env` and fill in. Placeholders only.
# `.env` is git-ignored. Never commit real keys.

# Market data: yahoo (free, delayed, unofficial, personal use) | eodhd (paid) | demo (synthetic)
QE_DATA_PROVIDER=yahoo
EODHD_API_KEY=your-eodhd-key-here

# Storage. Default is SQLite at ~/.quantedge/quantedge.db.
# Cloud example: postgresql+psycopg://quantedge:password@db:5432/quantedge
# QE_DATABASE_URL=

# Safety: only "research" or "paper" are accepted. There is no live mode.
QE_TRADING_MODE=research

# Years of daily history to load on first fetch
QE_HISTORY_YEARS=10

# AI agents (Phase 6). Leave QE_LLM_PROVIDER=none to disable all LLM calls.
QE_LLM_PROVIDER=none
QE_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=your-anthropic-key-here
QE_LLM_MONTHLY_BUDGET_USD=10
